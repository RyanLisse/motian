      "db:push:force": "drizzle-kit push",
      "lint": "biome check .",
      "lint:app": "biome check \"app/**/*.ts\" \"app/**/*.tsx\" \"components/**/*.ts\" \"components/**/*.tsx\" \"src/**/*.ts\" \"src/**/*.tsx\" \"hooks/**/*.ts\" \"lib/**/*.ts\" \"next.config.ts\" \"proxy.ts\"",
      "lint:shell": "biome check \"app/layout.tsx\" \"app/globals.css\" \"components/sidebar-layout.tsx\" \"components/mobile-bottom-nav.tsx\" \"components/route-shell-overlays.tsx\" \"components/chat/chat-widget.tsx\" \"components/sidebar/sidebar-job-list.tsx\" \"src/components/web-vitals-reporter.tsx\" \"scripts/check-shell-performance-budget.ts\"",
      "lint:fix": "biome check --write .",
      "test:app": "vitest run tests/chat-origin-boundary.test.ts tests/app-layout-command-palette.test.ts tests/chat-widget-continuity.test.ts tests/detail-surface-workflow.test.ts tests/recruiter-dashboard-navigation.test.ts",
      "test:coverage": "vitest run --coverage",
      "test:cv": "tsx scripts/test-cv-upload.ts",
      "test:cv:all": "tsx scripts/test-cv-upload.ts --all",
      "test:cv:generate": "tsx scripts/generate-test-cv.ts",
      "track:ai-costs": "npx ccusage",
      "baseline:metrics": "tsx scripts/baseline-metrics.ts",
      "benchmark:hybrid-search": "tsx scripts/benchmark-hybrid-search.ts",
      "metrics:esco-rollout": "tsx scripts/esco-rollout-snapshot.ts",
      "metrics:esco-rollout:compare": "tsx scripts/esco-rollout-compare.ts",
      "metrics:search-path-latency": "tsx scripts/measure-search-path-latencies.ts",
      "metrics:search-explain": "tsx scripts/explain-search-plans.ts",
      "perf:budget:shell": "tsx scripts/check-shell-performance-budget.ts",
      "perf:check:shell": "pnpm build && pnpm perf:budget:shell",
      "qa:mobile:expect": "npx expect-cli@latest --ci --yes --target changes --url http://localhost:3002 --message \"Validate mobile shell: safe-area insets, bottom tabs, touch targets, input zoom behavior, and viewport overflow regressions across /overzicht, /vacatures, /kandidaten, /pipeline, and /chat.\"",
