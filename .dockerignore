node_modules
# A bare pattern matches only the root; without this the workspaces'
# node_modules ride along in the context and overwrite the pnpm links
# the builder stage copied, breaking module resolution for packages/db.
**/node_modules
.next
**/.next
.git
.gitignore
tests
coverage
.env*
!.env.example
*.md
!docs/runbooks/coolify-dockerfile.md
.vscode
.cursor
.turbo
dist
build
*.log
.DS_Store
Thumbs.db
agent
.playwright
playwright-report
test-results
tmp
temp
.cache
beads
.beads
